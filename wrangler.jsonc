{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "seamscape",
  "compatibility_date": "2026-10-01",
  // The Worker only handles the live link between phone and desktop
  // (/relay/<session>, a WebSocket per page); everything else is a static
  // asset served without running it.
  "main": "worker/index.js",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": ["/relay/*"]
  },
  // One Durable Object per calibration session. It holds the open sockets
  // and stores nothing (SQLite-backed so it runs on the free plan).
  "durable_objects": {
    "bindings": [{ "name": "RELAY", "class_name": "Relay" }]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["Relay"] }
  ],
  "routes": [
    { "pattern": "seamscape.phaiting.com", "custom_domain": true }
  ]
}
